# =============================================================
# MLVerse X — Environment Configuration
# Copy this file to .env and fill in the values
# =============================================================

# ----- App -----
APP_NAME="MLVerse X"
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ----- JWT -----
JWT_SECRET_KEY=another-very-long-random-secret-key-for-jwt-tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Database -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mlverse
POSTGRES_USER=mlverse_user
POSTGRES_PASSWORD=mlverse_password_change_in_prod
DATABASE_URL=postgresql+asyncpg://mlverse_user:mlverse_password_change_in_prod@postgres:5432/mlverse
DATABASE_URL_SYNC=postgresql://mlverse_user:mlverse_password_change_in_prod@postgres:5432/mlverse

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ----- MinIO (Object Storage) -----
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=mlverse_minio_user
MINIO_ROOT_PASSWORD=mlverse_minio_password_change_in_prod
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_AVATARS=avatars
MINIO_SECURE=false

# ----- MLflow -----
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow-artifacts/

# ----- Ollama (Local LLM) -----
OLLAMA_HOST=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=5m

# ----- ChromaDB -----
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# ----- Email (SMTP) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=MLVerse X
SMTP_FROM_EMAIL=noreply@mlverse.ai
SMTP_TLS=true

# ----- Auth Providers (optional) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# ----- Rate Limiting -----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ----- File Upload -----
MAX_UPLOAD_SIZE_MB=500
ALLOWED_UPLOAD_EXTENSIONS=csv,xlsx,xls,json,parquet,txt,md,pdf,docx,pptx,zip,png,jpg,jpeg,mp4,mp3,wav

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=MLVerse X
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# ----- Embedding Model -----
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ----- Vector DB -----
VECTOR_DB_BACKEND=chromadb
# Options: chromadb, faiss

# ----- Admin -----
FIRST_SUPERUSER_EMAIL=admin@mlverse.ai
FIRST_SUPERUSER_PASSWORD=Admin@123!
